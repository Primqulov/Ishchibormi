{
	# ── Global sozlamalar (fayl BOSHIDA turishi shart) ──────────────────────
	servers {
		timeouts {
			# SLOWLORIS himoyasi. Hujum shundan iborat: ko'p ulanish ochib,
			# sarlavhalarni ataylab juda sekin yuborish. Server har biri uchun
			# slot ushlab turadi va oxir-oqibat yangi ulanish qabul qilolmaydi.
			# Sarlavhalar kichik — 10 soniya haqiqiy mijozga yetib ortadi,
			# hujumchi esa ulanishni cho'zolmaydi.
			read_header 10s

			# read_body ATAYLAB qo'yilmadi (standart holida qoladi): e'lon
			# rasmi 12MB gacha bo'lishi mumkin va sekin mobil internetda uni
			# yuklash daqiqalar oladi. Bu yerga qisqa qiymat qo'yish haqiqiy
			# foydalanuvchilarning rasm yuklashini buzardi.

			# Bo'sh (keep-alive) ulanishlarni ushlab turmaslik.
			idle 2m
		}
		# Haddan tashqari katta sarlavha — xotira tugatish usuli.
		max_header_size 16KB
	}
}

# Caddy — TLS terminator va reverse proxy (Hetzner server, XOSTDA ishlaydi).
#
# Nega konteynerda emas, xostda: docker-compose backend'ni 127.0.0.1:8080 ga,
# frontend'ni 127.0.0.1:3000 ga bog'laydi (tashqi dunyoga OCHIQ EMAS). Ya'ni
# yagona ochiq eshik shu Caddy. `docker compose down` qilinganda ham sertifikatlar
# va 80/443 xostda qolaveradi — deploy paytida domen "o'lmaydi".
#
# O'rnatish/yangilash:
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# TLS: Caddy Let's Encrypt sertifikatini AVTOMATIK oladi va yangilaydi —
# certbot/cron kerak emas. Yagona shart: domen A-yozuvi shu server IP'siga
# yo'naltirilgan va 80/443 portlar ufw'da ochiq bo'lsin.

# www -> apex. Bitta origin qoldiramiz: CORS_ORIGINS, NEXT_PUBLIC_API_BASE va
# cookie domeni bir xil bo'lsin (ikkitasi bo'lsa sessiya "yo'qoladi").
www.ishchibormi.uz {
	redir https://ishchibormi.uz{uri} permanent
}

# Mobil ilova (Play Market) uchun API subdomeni.
#
# NEGA ALOHIDA: flutter-app dagi ApiConfig.prodBaseUrl = https://api.ishchibormi.uz
# va u release build'ga KOMPILYATSIYA vaqtida yoziladi. Ya'ni allaqachon
# o'rnatilgan ilovalar shu manzilga murojaat qiladi va uni o'zgartirib
# bo'lmaydi — foydalanuvchi yangilanmaguncha. Shuning uchun domen server
# tomonida jonli turishi shart, aks holda eski ilovalar butunlay ishlamaydi.
#
# Bu yerda yo'llar bo'yicha ajratish YO'Q: subdomen faqat API uchun, backend
# o'zi /api/*, /uploads/*, /healthz ni ajratadi (apps/api/cmd/api/main.go).
api.ishchibormi.uz {
	encode zstd gzip

	# ── Xavfsizlik sarlavhalari ────────────────────────────────────────────
	header {
		# HTTPS ni majburlash (brauzer keyingi safar http:// ga urinmaydi).
		# includeSubDomains ATAYLAB YO'Q: mail./ftp. subdomenlari HTTPS
		# emas, ularni ham majburlash pochtani ishlamay qo'yishi mumkin.
		Strict-Transport-Security "max-age=31536000"
		# Brauzer fayl turini "taxmin qilmasin" — yuklangan rasm ichiga
		# yashiringan skript bajarilib ketmasin.
		X-Content-Type-Options "nosniff"
		# Saytni begona iframe ichiga joylashtirib bo'lmasin (clickjacking).
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Server nomi/versiyasini oshkor qilmaslik: hujumchiga qaysi
		# dasturiy ta'minot ekanini aytmaymiz.
		-Server
	}

	request_body {
		max_size 12MB
	}

	reverse_proxy 127.0.0.1:8080 {
		# Asosiy domendagi bilan bir xil mantiq: mijoz IP'sini ustiga yozamiz,
		# soxtalashtiriladigan sarlavhalarni olib tashlaymiz. Sababi
		# quyidagi ishchibormi.uz blokidagi izohda batafsil.
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
		header_up -True-Client-IP
		header_up -CF-Connecting-IP
		header_up -X-Forwarded-Host
	}

	log {
		output file /var/log/caddy/ishchibormi-api.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}

ishchibormi.uz {
	encode zstd gzip

	# ── Xavfsizlik sarlavhalari ────────────────────────────────────────────
	header {
		# HTTPS ni majburlash (brauzer keyingi safar http:// ga urinmaydi).
		# includeSubDomains ATAYLAB YO'Q: mail./ftp. subdomenlari HTTPS
		# emas, ularni ham majburlash pochtani ishlamay qo'yishi mumkin.
		Strict-Transport-Security "max-age=31536000"
		# Brauzer fayl turini "taxmin qilmasin" — yuklangan rasm ichiga
		# yashiringan skript bajarilib ketmasin.
		X-Content-Type-Options "nosniff"
		# Saytni begona iframe ichiga joylashtirib bo'lmasin (clickjacking).
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Server nomi/versiyasini oshkor qilmaslik: hujumchiga qaysi
		# dasturiy ta'minot ekanini aytmaymiz.
		-Server
	}

	# Zaxira chegara: eng katta yuklama e'lon rasmi — 8MB (+1MB multipart
	# ortiqchasi, apps/api/internal/upload/handler.go). 12MB shundan yuqori,
	# ya'ni haqiqiy chegarani API qo'yadi, Caddy faqat suiiste'moldan saqlaydi.
	request_body {
		max_size 12MB
	}

	# ── Android App Links: /.well-known/assetlinks.json ────────────────────
	# Android shu faylni o'qib, uz.ishchibormi.app ilovasi ROSTDAN HAM shu
	# domen egasiga tegishli ekanini tekshiradi. Tasdiqlangach, bu domenga
	# havolani bosgan foydalanuvchi brauzer o'rniga TO'G'RIDAN-TO'G'RI ilovaga
	# tushadi (ilova o'rnatilgan bo'lsa).
	#
	# Fayl emas, inline respond: Caddy caddy useri sifatida ishlaydi,
	# /opt/ishchibormi esa deploy niki — fayldan o'qishda ruxsat muammosi
	# chiqardi. Bu yerda esa konfiguratsiyaning o'zida turadi va repo bilan
	# birga versiyalanadi.
	#
	# IKKI barmoq izi ATAYLAB:
	#   1) Play App Signing kaliti — Play ilovani QAYTA imzolaydi, ya'ni
	#      foydalanuvchilar telefonidagi ilova aynan shu kalit bilan imzolangan.
	#      Bu bo'lmasa jonli ilovada App Links umuman ishlamaydi.
	#   2) Upload kaliti — lokal `flutter build apk --release` bilan yig'ilgan
	#      nusxani telefonda sinab ko'rish uchun.
	# Kalit o'zgarsa (Play Console -> App integrity -> App signing), bu yerni
	# ham yangilash SHART.
	handle /.well-known/assetlinks.json {
		header Content-Type "application/json"
		respond `[
  {
    "relation": ["delegate_permission/common.handle_all_urls"],
    "target": {
      "namespace": "android_app",
      "package_name": "uz.ishchibormi.app",
      "sha256_cert_fingerprints": [
        "DE:B4:EF:52:EC:6A:D2:5C:42:A5:80:73:16:DA:6F:13:AB:8D:35:59:48:96:57:88:E3:53:84:D3:0F:38:C6:BE",
        "30:66:C8:9A:8E:B6:06:C9:39:D6:51:DD:CA:35:E8:1D:19:91:0E:E9:9F:41:D7:AB:13:37:13:45:7E:98:2E:78"
      ]
    }
  }
]` 200
	}

	# Go API. Frontend Next.js bo'lgani uchun yo'llar bo'yicha ajratamiz:
	#   /api/*      — barcha REST endpoint'lar (cmd/api/main.go: r.Route("/api"))
	#   /uploads/*  — lokal diskdagi rasmlar (S3 sozlanmagan holat)
	#   /healthz    — monitoring
	@api path /api/* /uploads/* /healthz
	handle @api {
		reverse_proxy 127.0.0.1:8080 {
			# XAVFSIZLIK: Caddy standart holatda X-Forwarded-For'ga mijoz
			# IP'sini QO'SHADI — ya'ni mijoz o'zi yuborgan qiymat chapda
			# saqlanib qoladi. Backend rate-limit uchun shu sarlavhaga
			# tayanadi, shuning uchun uni butunlay ustiga yozamiz: bosqinchi
			# har so'rovda soxta IP yozib yangi "bucket" ocholmasin (admin
			# login/OTP brute-force himoyasi shunga bog'liq).
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
			# chi/boshqa kutubxonalar o'qishi mumkin bo'lgan, mijoz
			# soxtalashtira oladigan qolgan sarlavhalarni olib tashlaymiz.
			header_up -True-Client-IP
			header_up -CF-Connecting-IP
			header_up -X-Forwarded-Host
		}
	}

	# Qolgan hamma narsa — Next.js (SSR, statik fayllar, admin panel).
	handle {
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
			header_up -True-Client-IP
			header_up -CF-Connecting-IP
		}
	}

	log {
		output file /var/log/caddy/ishchibormi.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}
